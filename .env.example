# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=gemini-cyber
GOOGLE_CLOUD_LOCATION=us-central1
STAGING_BUCKET=gs://agent-staging-buck
AGENT_DISPLAY_NAME=spotify-3lo-agent

# Agent Identity Connector Configuration
SPOTIFY_3LO_AUTH_PROVIDER_ID=spotify-3lo-auth
CONTINUE_URI=http://localhost:8080/commit

# Spotify App Credentials (needed for connector setup only)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
